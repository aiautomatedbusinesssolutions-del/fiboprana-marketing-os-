# Copy this file to .env and fill in real values. Never commit .env — it's in
# .gitignore. Values here are placeholders only.

# ── LLM routing (fleet/llm.py) — OpenRouter primary, Anthropic fallback ──────
# ONE key, any provider's models (Claude, Gemini, GPT, Grok...). When set,
# every fleet-agent model call routes through OpenRouter and cost comes back
# server-computed. Without it, calls go direct to Anthropic via ANTHROPIC_API_KEY.
OPENROUTER_API_KEY=
# Anthropic fallback / direct path. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Per-run circuit breaker (defaults: $2.00 / 40 calls).
# LLM_RUN_MAX_COST_USD=2.00
# LLM_RUN_MAX_CALLS=40

# Per-task model overrides (defaults live in app.py). With OpenRouter active
# these can be any OpenRouter slug, e.g. "google/gemini-2.5-flash".
# MODEL_RADAR_TOPIC_SUMMARY=
# MODEL_RADAR_DIGEST=
# MODEL_CONTENT_PULL=
# MODEL_JUDGE=
# MODEL_DRAFTER=
# MODEL_DISTILLER=
# MODEL_EVAL_JUDGE=
# MODEL_REPURPOSER=

# ── Dashboard (default 5001; the sibling engine's dashboard owns 5000) ───────
PORT=5001

# ── Supabase — the shared marketing ledger for the agent fleet (fleet/) ──────
# ONE Fiboprana project for the whole business (decided 2026-08-26); marketing
# agents only ever touch the isolated `marketing` schema via a scoped role.
# Project URL + the ANON (public) key from Supabase -> Settings -> API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# OPTIONAL hardening: a JWT for the dedicated `hermes` role. Leave unset until
# you apply migration 20260625000001 (agents use anon until then). Mint it with
# `python -m fleet.mint_hermes_token`. Full runbook: fleet/SECURITY.md.
# SUPABASE_JWT_SECRET=
# SUPABASE_HERMES_JWT=

# Product-side Supabase (fiboprana-site) — read by fleet/metrics_agent.py for
# funnel numbers. Leave unset until the product database exists; the agent
# skips gracefully.
# PRODUCT_SUPABASE_URL=
# PRODUCT_SUPABASE_SERVICE_KEY=

# ── Research / sourcing ──────────────────────────────────────────────────────
EXA_API_KEY=

# ── Reddit (sourcing module + reply outcome checker) ─────────────────────────
# Register a "script" app at https://www.reddit.com/prefs/apps (~3 minutes).
# The account needs a Reddit PASSWORD set (Google-login-only accounts must add
# one in Settings), and password auth does not work with 2FA.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=fiboprana-marketing-scanner/0.1 by u/your-username
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Reply finder fetch source (reply_finder/config.yaml sets source: apify).
APIFY_TOKEN=

# ── X scheduling + outcomes ──────────────────────────────────────────────────
# X reply/post outcomes come from Typefully's analytics API; locally these can
# stay empty (falls back to the Typefully CLI's global config), set in the cloud.
TYPEFULLY_API_KEY=
TYPEFULLY_SOCIAL_SET_ID=
X_USERNAME=

# ── X reply finder (fleet/channels/x.py — Grok as the search eyes) ───────────
# xAI is currently the one affordable door that can SEARCH live X posts.
# Get a key at console.x.ai. After adding it, enable the channel:
XAI_API_KEY=
# REPLY_CHANNELS=reddit,x
# MODEL_X_SEARCH=grok-4.5   (xAI models only — x_search is an xAI capability)

# ── Google Search Console (fleet/metrics_agent.py) ───────────────────────────
# GSC_SITES=sc-domain:fiboprana.com

# ── Attribution module — base URL for short tracking links ───────────────────
# Default is fine for local-only verification. When links go into published
# posts, point at the public host (the /r/<code> route ships in fiboprana-site).
ATTRIBUTION_BASE_URL=http://localhost:5000

# ── Daily dispatcher (fleet/dispatch.py) — cloud-deploy vars ─────────────────
# HEALTHCHECKS_URL: healthchecks.io ping URL (dead-man's switch). Success pings
# it, failure pings <url>/fail; a MISSED ping is what alerts. Wire it before
# trusting the cron.
# HEALTHCHECKS_URL=
# DISPATCH_RESEARCH: "1" folds the Sunday research run into the dispatcher.
# Cutover rule (MARKETING_OS.md §5): never run this AND a standalone research
# cron in the same deploy (double runs).
# DISPATCH_RESEARCH=
